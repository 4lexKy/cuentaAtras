restar1Segundo()
{
    if (($segundos == 0));
    then
        if (($minutos == 0));
        then
            if (($horas == 0));
            then
                let "horas = 0"
                let "minutos = 0"
                let "segundos = 0"
            else
                let "horas--"
                let "minutos = 59"
                let "segundos = 59"
            fi
        else
            let "minutos--"
            let "segundos = 59"
        fi
    else
        let "segundos--"
    fi


}
sumar1Segundo()
{
    if (($segundos == 59));
    then
        if (($minutos == 59));
        then
            if (($horas == 99));
            then
                #Caso que no se usa
                let "horas = 0"
                let "minutos = 0"
                let "segundos = 0"
            else
                let "horas++"
                let "minutos = 00"
                let "segundos = 00"
            fi
        else
            let "minutos++"
            let "segundos = 00"
        fi
    else
        let "segundos++"
    fi

}
























